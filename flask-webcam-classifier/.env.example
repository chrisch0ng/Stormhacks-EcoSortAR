# Roboflow API Configuration
# Get your free API key from: https://app.roboflow.com/settings/api

ROBOFLOW_API_KEY=your_api_key_here

# Model ID - You can change this to use different models from Roboflow Universe
# Popular waste detection models:
# - garbage-classification-3/2 (default) - 6 classes: cardboard, glass, metal, paper, plastic, trash
# - waste-detection-zaofp/1 - Multiple waste types
# - taco-trash-annotations-in-context/11 - TACO dataset model
# Browse more at: https://universe.roboflow.com/search?q=waste%20detection

ROBOFLOW_MODEL_ID=garbage-classification-3/2
